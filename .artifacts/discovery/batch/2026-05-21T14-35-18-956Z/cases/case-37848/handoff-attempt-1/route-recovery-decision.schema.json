{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "oneOf": [
    {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "recoveryDecision",
        "selectedCandidateId",
        "action",
        "confidence",
        "sensitive",
        "rationale"
      ],
      "properties": {
        "recoveryDecision": {
          "type": "string",
          "enum": [
            "repaired_plan"
          ]
        },
        "selectedCandidateId": {
          "type": "string",
          "minLength": 1
        },
        "action": {
          "type": "string",
          "minLength": 1
        },
        "confidence": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "sensitive": {
          "type": "boolean"
        },
        "rationale": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "recoveryDecision",
        "rationale"
      ],
      "properties": {
        "recoveryDecision": {
          "type": "string",
          "enum": [
            "no_safe_action"
          ]
        },
        "rationale": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "recoveryDecision",
        "unresolvedQuestions",
        "rationale"
      ],
      "properties": {
        "recoveryDecision": {
          "type": "string",
          "enum": [
            "needs_more_context"
          ]
        },
        "unresolvedQuestions": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 1
        },
        "rationale": {
          "type": "string",
          "minLength": 1
        }
      }
    }
  ]
}
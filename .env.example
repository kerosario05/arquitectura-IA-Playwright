# Target web application
APP_BASE_URL=
RUNTIME_CONFIRMED_REPLAY_ENABLED=true
APP_LOGIN_MODE=password
APP_USERNAME=
APP_PASSWORD=
APP_EXTRA_LOGIN_FIELDS_JSON=

# Browser execution
HEADLESS=false
BROWSER=chromium
EVIDENCE_DIR=./evidence
# Persistent project-scoped fixtures used by Test Design and Test Launch.
# In deployments, point this at a durable volume outside versioned/release folders.
# Defaults to a sibling `test-files` directory next to EVIDENCE_DIR.
TEST_FILE_STORAGE_DIR=
DEFAULT_TIMEOUT_MS=30000
# Post-action async waits: idle window may renew on meaningful progress;
# hard safety cap is the fixed maximum for one active operation.
# LOADING_STABILITY_TIMEOUT_MS=8000
# ASYNC_OPERATION_HARD_SAFETY_CAP_MS=120000
# Optional dedicated persistent browser profile for the QA runtime. Leave empty
# (the deterministic default) to use a fresh ephemeral context each run, which
# avoids leaking service workers / storage / cookies / history between apps and
# runs. Set it only when a pre-authenticated corporate profile is required; keep
# it separate from the user's corporate Edge profile.
QA_BROWSER_PROFILE_PATH=
# Optional installed Playwright channel, e.g. edge. Leave empty to use BROWSER.
QA_BROWSER_CHANNEL=

# Android / Appium (native app automation)
# ANDROID_HOME=/Users/you/Library/Android/sdk
ANDROID_AVD_NAME=Pixel_7_Pro
ANDROID_APK_PATH=
ANDROID_APP_PACKAGE=
ANDROID_APP_ACTIVITY=
ANDROID_EMULATOR_HEADLESS=true
ANDROID_EMULATOR_BOOT_TIMEOUT_MS=120000
APPIUM_SERVER_PORT=4723
APPIUM_BIN=appium
MOBILE_KNOWLEDGE_LEARNING_ENABLED=true
# Before pressing accept/continue, auto-tick an un-checked consent/terms checkbox (default true)
MOBILE_AUTO_CONSENT_CHECKBOX_ENABLED=true
# If a step's target isn't found, close a blocking modal/dialog and look for it underneath (default true)
MOBILE_MODAL_RECOVERY_ENABLED=true
# Restart (terminate + relaunch) the app before each scenario so it starts from 0 (default true)
MOBILE_RESTART_APP_BETWEEN_SCENARIOS=true
# Before clicking, wait for the button/element to be enabled; fail clearly if it stays disabled (default true)
MOBILE_REQUIRE_ENABLED_BEFORE_CLICK=true

# Future TestRail integration
TESTRAIL_URL=
TESTRAIL_EMAIL=
TESTRAIL_API_KEY=
TESTRAIL_PROJECT_ID=
TESTRAIL_SUITE_ID=
TESTRAIL_SECTION_ID=

# Jira integration
JIRA_BASE_URL=
JIRA_EMAIL=
JIRA_API_TOKEN=
JIRA_PROJECT_KEY=
JIRA_ACCEPTANCE_CRITERIA_FIELD=description
JIRA_DRY_RUN=false
JIRA_JQL=

# Agent / AI handoff
AI_PROVIDER=codex_handoff
AI_MODEL=codex
AI_STRUCTURED_OUTPUTS=true

# Agente local de grabación
# Opcional. Carpeta chromium-<rev> que el agente local instala en los PCs, en lugar de la que pide Playwright.
# Útil cuando el servidor no tiene internet y solo tiene otra revisión. Ej.: C:\qa\ms-playwright\chromium-1193
LOCAL_AGENT_CHROMIUM_DIR=

# Planificación de pruebas (test-plan-<HU>.md en un repositorio git)
# Requiere git instalado y en el PATH del servidor.
# El repositorio de cada proyecto se configura en el panel: Configuración > proyecto > Repositorio.
# Credencial: vacía en el panel = credenciales de git de la máquina (uso local).
# En servidor: PAT de Azure DevOps con permiso Code (Read & Write), y en el panel env:AZDO_GIT_PAT.
# El nombre de la variable debe contener GIT_PAT o GIT_TOKEN.
# AZDO_GIT_PAT=
# Carpeta donde el motor mantiene sus clones. Por defecto data/repos.
# GIT_REPOS_DIR=data/repos

# Future discovery configuration
DISCOVERY_MODE=false
AUTO_APPROVE_DISCOVERED_OBJECTS=false

# Codex CLI auto-repair
CODEX_CLI_COMMAND=codex
CODEX_CLI_EXTRA_ARGS=--skip-git-repo-check --sandbox workspace-write
CODEX_AUTO_REPAIR_TIMEOUT_MS=900000
CODEX_AUTO_REPAIR_PROMPT_MODE=compact
CODEX_AUTO_REPAIR_ENABLED=false

# AI Provider Configuration
AI_ENABLED=true
AI_PROVIDER=copilot_cli
AI_PROVIDER_NAME=copilot
AI_MODEL=claude-sonnet-4.6
AI_TIMEOUT_MS=30000

# ==========================================
# Purpose-Specific AI Configuration
# ==========================================
# Configure different AI providers/models for different purposes:
# - scenario_generation: Generating MCP-ready scenarios from Jira issues
# - repair: AI auto-repair during discovery/execution

# Scenario Generation AI Configuration
# Higher timeout and more capable model for complex scenario generation
AI_SCENARIO_PROVIDER=copilot_cli
AI_SCENARIO_MODEL=claude-opus-4.8
AI_SCENARIO_TIMEOUT_MS=240000
AI_SCENARIO_MAX_ATTEMPTS=1

# Repair AI Configuration
# Faster model and lower timeout for quick repair decisions
AI_REPAIR_PROVIDER=copilot_cli
AI_REPAIR_MODEL=claude-sonnet-4.6
AI_REPAIR_TIMEOUT_MS=60000
AI_REPAIR_MAX_ATTEMPTS=1

# Spec generation: Codex CLI model and reasoning configuration
AI_SPEC_PROVIDER=codex_cli
AI_SPEC_MODEL=gpt-5.6-luna
AI_SPEC_REASONING_EFFORT=medium
AI_SPEC_TIMEOUT_MS=360000
AI_SPEC_MAX_ATTEMPTS=1

# ==========================================
# Copilot CLI Provider Configuration
# ==========================================
# Command to invoke Copilot CLI (defaults to "copilot")
# COPILOT_CLI_COMMAND=copilot

# Extra arguments for Copilot CLI (space-separated)
# COPILOT_CLI_EXTRA_ARGS=--skip-git-repo-check --sandbox workspace-write

# ==========================================
# Codex CLI Provider (Legacy)
# ==========================================
# Still supported as a legacy provider if explicitly configured
# CODEX_CLI_COMMAND=codex
# CODEX_CLI_EXTRA_ARGS=--skip-git-repo-check --sandbox workspace-write

# AI Repair Configuration
AI_REPAIR_ENABLED=true
AI_REPAIR_MODE=compact
AI_REPAIR_MAX_CONTEXT_CHARS=30000
AI_REPAIR_REQUIRE_JSON=true
AI_REPAIR_REQUIRE_JSON_SCHEMA=true
AI_REPAIR_MUST_RETURN_EXISTING_CANDIDATE_ID=true
AI_REPAIR_MUST_USE_VISIBLE_CANDIDATE=true
AI_REPAIR_BLOCK_SENSITIVE_ACTIONS=true
AI_REPAIR_BLOCK_AUTH_SECRETS=true
AI_REPAIR_BLOCK_PAYMENTS=true
AI_REPAIR_BLOCK_TRANSFERS=true

# Jira-only runtime DOM assistance. Defaults to AI_REPAIR_MODEL/provider when omitted.
# Calls are bounded and only receive sanitized visible DOM candidates/evidence.
# AI_JIRA_TARGET_MODEL=gpt-5.6-luna
# AI_JIRA_TARGET_TIMEOUT_MS=12000
# AI_JIRA_ASSERTION_MODEL=gpt-5.6-luna
# AI_JIRA_ASSERTION_TIMEOUT_MS=45000

# AI Repair Attempt Limits (per case/segment)
AI_ROUTE_RECOVERY_MAX_ATTEMPTS_PER_CASE=1
AI_ASSERTION_REPAIR_MAX_ATTEMPTS_PER_CASE=1
AI_SELECTION_REPAIR_MAX_ATTEMPTS_PER_CASE=1

# Agent Auto-Repair (future)
AGENT_AUTO_REPAIR_ENABLED=false

# ==========================================
# Codex CLI Provider (AI Repair)
# ==========================================
# Usar Codex CLI como proveedor de AI Repair
# El provider agrega "exec" automÃ¡ticamente - NO incluirlo en EXTRA_ARGS

# AI_ENABLED=true
# AI_PROVIDER=codex_cli
# AI_PROVIDER_NAME=codex
# AI_MODEL=codex
# AI_TIMEOUT_MS=120000

# Opcional: si no se define, se resuelve automÃ¡ticamente
# Prioridad: 1) CODEX_CLI_COMMAND, 2) resolveCodexCliPath(), 3) "codex" desde PATH
# CODEX_CLI_COMMAND=C:\Users\roque\AppData\Roaming\npm\codex.cmd

# NO incluir "exec" - el provider lo agrega automÃ¡ticamente
# Ejemplo correcto (argumentos vÃ¡lidos para 'codex exec'):
# CODEX_CLI_EXTRA_ARGS=--skip-git-repo-check --sandbox workspace-write

# Legacy Agent Auto-Repair (DEBE permanecer apagado cuando usa AI Repair)
# AGENT_PROVIDER=none
# AGENT_AUTO_REPAIR_ENABLED=false

# ==========================================
# Catalog Discovery Configuration
# ==========================================
# Product catalog discovery for QA Lab scenario generation
#
# Discovery runs ONLY during "Generate scenarios" button in QA Lab
# as a context enrichment phase. It does NOT execute tests or generate evidence.
#
# Multiproject-safe: No hardcoded products/categories/appSlug required.

# Enable catalog discovery during scenario generation
# AI_CATALOG_AUTO_DISCOVER=true

# Catalog mode: existing (use cached) or refresh (re-discover)
# - existing: Use products from app.config.json if present; discover if missing
# - refresh: Always re-discover and refresh the catalog
# AI_CATALOG_MODE=existing

# Coverage mode for scenario generation: representative or exhaustive
# - representative: AI selects subset of products (1-2 per category) aligned with HU
# - exhaustive: AI + deterministic seeds cover ALL products aligned with HU scope
#   (NOT entire global catalog, only products relevant to the user story)
# AI_CATALOG_COVERAGE_MODE=representative
# AI_CATALOG_COVERAGE_MODE=representative

# Maximum products per category in representative mode (default: 2)
# AI_CATALOG_MAX_PER_CATEGORY=2

# Maximum depth for multilevel catalog exploration (default: 3)
# Deeper catalogs with categories/subcategories may need depth 3-4
# AI_CATALOG_DISCOVERY_MAX_DEPTH=3
# CODEX_AUTO_REPAIR_ENABLED=false
# CODEX_AUTO_REPAIR_PROMPT_MODE=disabled

# ============================================
# Project registry database (/api/projects)
# ============================================
# sqlite (default, zero setup) or sqlserver (requires the odbc package + ODBC Driver 18)
DB_DRIVER=sqlite

# sqlite: database file, relative to the repo root. Created automatically.
SQLITE_DB_PATH=data/qa-lab.db

# sqlserver only:
# SQL_SERVER_HOST=localhost
# SQL_SERVER_DATABASE=QA_LAB
# SQL_SERVER_TRUSTED_CONNECTION=true

# Data_Cedulas source service used by QALab (SQL Server -> Oracle)
DATA_CEDULAS_SQL_SERVER=SRVDEVBIZDB01
DATA_CEDULAS_SQL_DATABASE=BitacoraBuro
DATA_CEDULAS_SQL_USER=
DATA_CEDULAS_SQL_PASSWORD=
DATA_CEDULAS_SQL_REQUEST_TIMEOUT_MS=60000
DATA_CEDULAS_ORACLE_USER=
DATA_CEDULAS_ORACLE_PASSWORD=
DATA_CEDULAS_ORACLE_SCHEMA=PA
DATA_CEDULAS_ORACLE_CLIENT_LIB_DIR=C:\\instantclient_19_32
DATA_CEDULAS_ORACLE_TNS_ADMIN=C:\\instantclient_19_32\\network\\admin
DATA_CEDULAS_MAX_BATCHES=100
DATA_CEDULAS_RANDOM_POOL_SIZE=10
# Max age (days) of the score consultation a candidate needs; the Portal only loads rates for recent ones. 0 disables.
DATA_CEDULAS_SCORE_MAX_AGE_DAYS=30
# Minimum score and CV income estimator so the credit decision engine does not reject the customer. 0 disables each one.
DATA_CEDULAS_MIN_SCORE=780
DATA_CEDULAS_MIN_INCOME_ESTIMATOR=40000
DATA_CEDULAS_LEXIS_TIMEOUT_MS=5000
DATA_CEDULAS_LEXIS_SCREEN_POOL_SIZE=3
# strict requires the external MDT4/Lexis Nexis check; local_only uses the
# local Oracle PLAFT lists and marks the response as externally unverified.
DATA_CEDULAS_PLAFT_MODE=strict
# strict applies to the selected transport's assigned database. Unassigned
# instances retain local filters and return X-Data-Cedulas-PLAFT=local_only_unverified.
# An assigned instance never falls back when MDW/Lexis fails.
DATA_CEDULAS_LEXIS_TRANSPORT=portal
# mdw uses the observed SOAP contract; alias must match its configured environment.
DATA_CEDULAS_LEXIS_MDW_URL=
DATA_CEDULAS_LEXIS_MDW_DATABASE=
DATA_CEDULAS_LEXIS_MDW_CLIENT_ID=
# Portal endpoint must correspond to the selected Oracle alias.
DATA_CEDULAS_LEXIS_PORTAL_URL=
DATA_CEDULAS_LEXIS_PORTAL_DATABASE=QA1
DATA_CEDULAS_LEXIS_PORTAL_COOKIE=
DATA_CEDULAS_LEXIS_PORTAL_AUTHORIZATION=
DATA_CEDULAS_LEXIS_PORTAL_IGNORE_HTTPS_ERRORS=false

# API server
# PORT=3001
# API_HOST=0.0.0.0
# API_CORS_ORIGIN=*
# API_KEY=

# Portal Comercial QA request cancellation (disabled per project by default).
# HTTPS host must be listed in PORTAL_COMERCIAL_QA_API_ALLOWED_HOSTS.
# Keep QA authorization/cookie values in the server secret store; never commit them.
# PORTAL_COMERCIAL_QA_API_BASE_URL=https://qa-host.example
# PORTAL_COMERCIAL_QA_API_ALLOWED_HOSTS=qa-host.example
# PORTAL_COMERCIAL_QA_API_AUTHORIZATION=
# PORTAL_COMERCIAL_QA_API_COOKIE=

# Disable spec generation/promotion on recording runs while keeping Discovery results and run statistics.
RECORDING_SPEC_GENERATION_ENABLED=true
# Disable spec generation/promotion on Jira scenario runs while keeping Discovery results and run statistics.
JIRA_SPEC_GENERATION_ENABLED=true
# Maximum number of public automation jobs executing at once; additional jobs wait in memory.
QA_LAB_MAX_CONCURRENT_JOBS=4

# Optional: CSS selector list of layout containers that keep a "loading" class for the page's whole life.
# They stop counting as a loader in the post-action wait. Quote the value: an unquoted leading "#" is read as
# a dotenv comment and the value becomes empty. Example: "#ui-bizagi-wp-workarea"
# ASYNC_WAIT_IGNORE_LOADER_SELECTOR=""

# Agente local de grabación
# Opcional. Carpeta chromium-<rev> que el agente local instala en los PCs, en lugar de la que pide Playwright.
# Útil cuando el servidor no tiene internet y solo tiene otra revisión. Ej.: C:\qa\ms-playwright\chromium-1193
LOCAL_AGENT_CHROMIUM_DIR=

# Portal Comercial API database (cancel a creator's requests from the service panel).
# Not secrets. The user and password are typed in the panel and stored encrypted.
PORTAL_DB_SERVER=
PORTAL_DB_DATABASE=
# Portal API database sign-in. Preferred: path (relative to the project) of a copy of the API's appsettings.json
# holding only DatabaseSettings:Default, e.g. data/portal-api/appsettings.json (that folder is ignored by git: it has the password).
# When set, server, database, user and password come from it and PORTAL_DB_* are not needed.
PORTAL_API_APPSETTINGS=

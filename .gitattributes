# Normalize text files and avoid CRLF/LF noise across Windows/Linux
* text=auto

# Source/config files should stay LF in the repository
*.ts text eol=lf
*.tsx text eol=lf
*.js text eol=lf
*.jsx text eol=lf
*.json text eol=lf
*.md text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.css text eol=lf
*.html text eol=lf
*.sh text eol=lf

# Windows command files can stay CRLF
*.cmd text eol=crlf
*.bat text eol=crlf

* text=auto


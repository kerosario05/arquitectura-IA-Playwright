<?xml version="1.0" encoding="UTF-8"?>
<!--
  Sitio de QA Lab en IIS.

  Hace dos cosas: publica el estático de React y reenvía /api al BFF en :3001.
  Va junto al index.html del sitio (por ejemplo C:\inetpub\qa-lab\web.config).

  Requiere los módulos URL Rewrite y Application Request Routing, con el proxy
  de ARR habilitado a nivel de servidor.
-->
<configuration>
  <system.webServer>

    <rewrite>
      <rules>
        <!--
          Logs en vivo (Server-Sent Events). Va ANTES de la regla general porque
          necesita responseBufferLimit=0: ARR bufferiza las respuestas por
          defecto y el stream llegaría a golpes, o no llegaría, haciendo que el
          panel de ejecución parezca congelado.
        -->
        <rule name="SSE de logs" stopProcessing="true">
          <match url="^api/runs/([^/]+)/logs$" />
          <action type="Rewrite" url="http://127.0.0.1:3001/api/runs/{R:1}/logs"
                  responseBufferLimit="0" />
          <serverVariables>
            <set name="HTTP_X_FORWARDED_HOST" value="{HTTP_HOST}" />
            <set name="HTTP_X_FORWARDED_PROTO" value="https" />
          </serverVariables>
        </rule>

        <!--
          Todo /api va al BFF. El motor (:3002) NO se publica: solo el BFF habla
          con él, y lo hace por localhost.
        -->
        <rule name="API al BFF" stopProcessing="true">
          <match url="^api/(.*)" />
          <action type="Rewrite" url="http://127.0.0.1:3001/api/{R:1}" />
          <serverVariables>
            <!-- Sin esto el BFF no ve el host original en los logs. -->
            <set name="HTTP_X_FORWARDED_HOST" value="{HTTP_HOST}" />
            <set name="HTTP_X_FORWARDED_PROTO" value="https" />
          </serverVariables>
        </rule>

        <!--
          Aplicación de una sola página: cualquier ruta que no sea un archivo
          real se sirve como index.html para que el enrutado del navegador
          funcione al recargar (por ejemplo /checklist/AA-123).
        -->
        <rule name="SPA" stopProcessing="true">
          <match url=".*" />
          <conditions logicalGrouping="MatchAll">
            <add input="{REQUEST_FILENAME}" matchType="IsFile" negate="true" />
            <add input="{REQUEST_FILENAME}" matchType="IsDirectory" negate="true" />
            <add input="{REQUEST_URI}" pattern="^/api/" negate="true" />
          </conditions>
          <action type="Rewrite" url="/index.html" />
        </rule>
      </rules>
    </rewrite>

    <!--
      Los assets de Vite llevan hash en el nombre, así que pueden cachearse a
      largo plazo; index.html nunca, o el navegador seguiría sirviendo la versión
      anterior tras un despliegue.
    -->
    <staticContent>
      <remove fileExtension=".json" />
      <mimeMap fileExtension=".json" mimeType="application/json" />
      <remove fileExtension=".webmanifest" />
      <mimeMap fileExtension=".webmanifest" mimeType="application/manifest+json" />
      <clientCache cacheControlMode="UseMaxAge" cacheControlMaxAge="365.00:00:00" />
    </staticContent>

    <caching>
      <profiles>
        <add extension=".html" policy="DisableCache" kernelCachePolicy="DisableCache" />
      </profiles>
    </caching>

    <httpProtocol>
      <customHeaders>
        <remove name="X-Powered-By" />
        <add name="X-Content-Type-Options" value="nosniff" />
        <add name="X-Frame-Options" value="SAMEORIGIN" />
        <add name="Referrer-Policy" value="strict-origin-when-cross-origin" />
      </customHeaders>
    </httpProtocol>

    <security>
      <requestFiltering>
        <!-- Subida de APKs: el límite por defecto de IIS (30 MB) se queda corto. -->
        <requestLimits maxAllowedContentLength="268435456" />
      </requestFiltering>
    </security>

  </system.webServer>
</configuration>
